# LLM Configuration for the Orchestrator (Phase 5)
#
# These match the Ollama setup in .opencode/opencode.json by default.
# Ollama provides an OpenAI-compatible API at http://127.0.0.1:11434/v1.
#
# For other providers (LM Studio, vLLM, OpenAI, etc.), update these:
#
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5-coder:7b
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
